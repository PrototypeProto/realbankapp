MONGOUSER=mongouser
MONGOPASSWORD=mongopassword
MONGOHOST=db.aaaaaa.mongodb.net
MONGODB=mongodb
MONGOAPPNAME=mongoapp

# JWT signing. Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GenerateASecretHerePleaseForSecurityPurposesPleasePleasePlease!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookies. Keep secure=false for local http; set true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
